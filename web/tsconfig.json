{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@pixelbolt/*": ["../third_party/Pixelbolt/src/*"],
      "@ppae/*": ["../third_party/ppae-engine/src/*"],
      "@autotiler/*": ["../third_party/autotiler/src/core/*"],
      "fflate": ["./node_modules/fflate"],
      "fast-png": ["./node_modules/fast-png/lib/index.d.ts"]
    }
  },
  "include": ["src"]
}
